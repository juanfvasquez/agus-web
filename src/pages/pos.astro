---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import PricingCard from '../components/PricingCard.astro';
import PosDeviceMockup from '../components/pos/PosDeviceMockup.astro';
import PricingComparison from '../components/PricingComparison.astro';
import ThreeHeroScene from '../components/ThreeHeroScene.astro';
import { whatsappUrl, whatsappMessages } from '../data/site';
import { posNav } from '../data/navigation';
import {
  valueProps,
  problemSolutions,
  modules,
  plans,
  comparisonRows,
  posOnboardingSteps,
  posFaqs,
} from '../data/pos';
---

<BaseLayout
  title="Agus POS - Gestión de comercios"
  description="Sistema POS para restaurantes y comercios. Gestiona mesas, comandas, inventario, caja y empleados. Planes desde $24.900/mes."
>
  <Header currentPage="pos" navLinks={posNav} />

  <main>
    <section class="hero-agus section-agus border-b border-white/15">
      <ThreeHeroScene />

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="reveal">
            <h1
              class="text-3xl sm:text-5xl lg:text-[3.1rem] font-extrabold leading-[1.08] text-white mb-5"
            >
              El POS que pone tu negocio bajo control total
            </h1>
            <p class="text-lg text-white/90 max-w-xl mb-8 leading-relaxed">
              Mesas, comandas, inventario, caja y empleados — todo en tiempo real, desde cualquier
              dispositivo.
            </p>
            <div class="flex flex-wrap gap-3.5">
              <a
                href={whatsappUrl(whatsappMessages.pos)}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-agus bg-white text-brand-orange hover:bg-brand-wash"
              >
                <i class="ri-whatsapp-line text-lg" aria-hidden="true"></i>
                <span>Solicitar demo personalizada</span>
              </a>
              <a href="#planes" class="btn-agus-ghost">Ver planes y precios</a>
            </div>
          </div>

          <div class="reveal flex justify-center lg:justify-end">
            <PosDeviceMockup />
          </div>
        </div>
      </div>
    </section>

    <section class="py-8 bg-brand-dark text-white border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 reveal-stagger">
          {
            valueProps.map((prop) => (
              <div class="reveal flex items-center gap-3.5 justify-center lg:justify-start">
                <div class="w-11 h-11 bg-brand-orange/20 rounded-btn flex items-center justify-center shrink-0">
                  <i class:list={[`${prop.icon} text-brand-lightOrange text-xl`]} aria-hidden="true" />
                </div>
                <span class="text-sm font-bold text-white/90">{prop.text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Problem → Solution Before/After Matrix -->
    <section class="section-agus section-orange">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">De problemas reales a soluciones concretas</h2>
          <p class="text-brand-secondary/80 text-base sm:text-lg">
            Diseñamos Agus POS para resolver los dolores de cabeza que enfrentan restaurantes, cafés y
            comercios en cada turno.
          </p>
        </ScrollReveal>

        <div class="grid md:grid-cols-3 gap-8 reveal-stagger">
          {
            problemSolutions.map((item) => (
              <div class="reveal spotlight-card bg-white rounded-card shadow-elevated card-hover overflow-hidden flex flex-col justify-between">
                <div class="p-7 pb-5 border-b border-brand-secondary/10 bg-brand-wash/60">
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-secondary/60 mb-2">
                    <i class="ri-indeterminate-circle-line text-sm text-brand-darkOrange" aria-hidden="true" />
                    <span>Operación tradicional</span>
                  </span>
                  <p class="text-base font-semibold text-brand-secondary/75 line-through decoration-brand-orange/50">
                    {item.problem}
                  </p>
                </div>

                <div class="p-7 pt-6 bg-white flex-1 flex flex-col justify-between">
                  <div>
                    <div class="w-12 h-12 bg-brand-washDeep rounded-btn flex items-center justify-center mb-4">
                      <i class:list={[`${item.icon} text-2xl text-brand-orange`]} aria-hidden="true" />
                    </div>
                    <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-emerald-700 bg-emerald-500/15 px-2.5 py-0.5 rounded-full mb-2">
                      Con Agus POS
                    </span>
                    <h3 class="text-xl font-extrabold text-brand-secondary">{item.solution}</h3>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="modulos" class="section-agus surface-section">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">Todo lo que necesitas, en un solo sistema</h2>
          <p class="text-brand-secondary/80 text-base sm:text-lg">
            Módulos potentes que crecen contigo. Empieza con lo esencial y escala cuando tu operación lo
            requiera.
          </p>
        </ScrollReveal>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-7 reveal-stagger">
          {
            modules.map((mod, idx) => {
              const isHighlight = idx === 1 || idx === 2;
              return (
                <div class="reveal spotlight-card p-7 rounded-card bg-white shadow-elevated card-hover flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between mb-5">
                      <div class="w-12 h-12 bg-brand-washDeep text-brand-orange rounded-btn flex items-center justify-center text-2xl">
                        <i class={mod.icon} aria-hidden="true" />
                      </div>
                      <span
                        class:list={[
                          'text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-btn',
                          isHighlight
                            ? 'bg-brand-orange text-white'
                            : 'bg-brand-section text-brand-secondary',
                        ]}
                      >
                        {mod.plan}+
                      </span>
                    </div>
                    <h3 class="text-xl font-extrabold text-brand-secondary mb-4">{mod.title}</h3>
                    <ul class="space-y-2.5">
                      {mod.features.map((f) => (
                        <li class="text-sm text-brand-secondary/85 flex items-start gap-2.5 font-medium">
                          <i
                            class="ri-checkbox-circle-fill text-brand-orange shrink-0 mt-0.5"
                            aria-hidden="true"
                          />
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="planes" class="section-agus section-wash-deep border-t border-brand-orange/15">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">Elige el plan perfecto para tu negocio</h2>
          <p class="text-brand-secondary/80 text-base sm:text-lg">
            Precios transparentes en pesos colombianos. Sin costos ocultos ni cláusulas de permanencia.
          </p>
        </ScrollReveal>

        <div class="grid lg:grid-cols-3 gap-8 items-stretch reveal-stagger">
          {plans.map((plan) => <PricingCard plan={plan} />)}
        </div>
      </div>
    </section>

    <section id="comparativa" class="section-agus section-orange">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">Comparativa detallada de planes</h2>
          <p class="text-brand-secondary/80 text-base sm:text-lg">
            Revisa cada módulo y capacidad incluida para elegir con total confianza.
          </p>
        </ScrollReveal>

        <PricingComparison rows={comparisonRows} />
      </div>
    </section>

    <section class="section-agus section-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title-light">Empieza en 3 simples pasos</h2>
          <p class="text-brand-washDeep/80 text-base sm:text-lg">
            De la demostración inicial al primer pedido facturado en menos de 48 horas.
          </p>
        </ScrollReveal>

        <div class="grid md:grid-cols-3 gap-8 reveal-stagger">
          {
            posOnboardingSteps.map((step) => (
              <div class="reveal bg-white/[0.06] border border-white/10 p-8 rounded-card transition-transform duration-300 ease-agus hover:-translate-y-1">
                <span class="inline-flex w-12 h-12 bg-brand-orange text-white rounded-btn items-center justify-center font-extrabold text-lg mb-6 shadow-glow-orange tabular-nums">
                  {step.step}
                </span>
                <h3 class="text-xl font-bold mb-3 text-white">{step.title}</h3>
                <p class="text-brand-washDeep/80 text-sm sm:text-base leading-relaxed">
                  {step.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="faq" class="section-agus section-wash-deep">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center mb-16">
          <h2 class="section-title">Preguntas Frecuentes</h2>
          <p class="text-brand-secondary/80 text-base sm:text-lg">
            Todo lo que necesitas saber sobre la implementación y soporte de Agus POS.
          </p>
        </ScrollReveal>

        <FAQ faqs={posFaqs} />
      </div>
    </section>

    <CTASection
      title="Empieza a gestionar tu negocio como un profesional"
      subtitle="Escríbenos y te mostramos una demo personalizada para tu tipo de negocio."
      message={whatsappMessages.pos}
    />
  </main>

  <Footer
    title="¿Listo para modernizar tu operación?"
    subtitle="Contáctanos y elige el plan POS ideal para tu negocio."
    ctaText="Hablar con un asesor →"
    ctaMessage={whatsappMessages.pos}
  />
</BaseLayout>
