---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppLandingHeader from '../components/app/AppLandingHeader.astro';
import AppLandingFooter from '../components/app/AppLandingFooter.astro';
import ThreeHeroScene from '../components/ThreeHeroScene.astro';
import { appDownloadPage } from '../data/app-download';
import { APP_STORE_URL, PLAY_STORE_URL, ORDERS_WEB_URL } from '../data/site';

const { hero, features, storeBadges, redirectMessage, redirectHint } = appDownloadPage;
---

<BaseLayout
  title={appDownloadPage.title}
  description={appDownloadPage.description}
  ogImage={appDownloadPage.ogImage}
  ogTitle={appDownloadPage.title}
>
  <div data-app-download-page>
    <AppLandingHeader />

    <main>
      <div
        id="app-redirect-state"
        class="hidden hero-agus section-agus min-h-[calc(100vh-72px-120px)] flex items-center"
      >
        <div class="max-w-xl mx-auto px-4 text-center relative z-10">
          <div
            class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white/15 mb-6"
            aria-hidden="true"
          >
            <i class="ri-loader-4-line text-3xl text-white animate-spin"></i>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-white mb-3">{redirectMessage}</h1>
          <p class="text-brand-washDeep/85 mb-8">{redirectHint}</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href={PLAY_STORE_URL}
              data-store-link="android"
              data-store-source="landing"
              aria-label="Descargar en Google Play"
            >
              <img
                src={storeBadges.playStore}
                alt="Google Play"
                class="h-12 w-auto hover:scale-105 transition-transform"
              />
            </a>
            <a
              href={APP_STORE_URL}
              data-store-link="ios"
              data-store-source="landing"
              aria-label="Descargar en App Store"
            >
              <img
                src={storeBadges.appStore}
                alt="App Store"
                class="h-12 w-auto hover:scale-105 transition-transform"
              />
            </a>
          </div>
        </div>
      </div>

      <div id="app-landing-content">
        <section class="hero-agus section-agus min-h-[calc(100vh-72px-100px)] flex items-center">
          <ThreeHeroScene />

          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-10">
            <div class="grid lg:grid-cols-[1.08fr_0.92fr] gap-12 lg:gap-16 items-center">
              <div class="reveal order-2 lg:order-1">
                <h1
                  class="text-3xl sm:text-5xl lg:text-[3.25rem] font-extrabold leading-[1.08] text-white mb-5"
                >
                  {hero.title}
                </h1>
                <p class="text-lg text-white/90 leading-relaxed mb-8 max-w-xl">
                  {hero.subtitle}
                </p>

                <!-- Action CTA: Pedir en la Web (Destacado) -->
                <div
                  class="bg-brand-dark/80 backdrop-blur-md border border-white/15 rounded-card p-6 mb-8 max-w-xl shadow-elevated-lg"
                >
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                      <h2 class="text-white font-bold text-base flex items-center gap-2">
                        <i class="ri-computer-line text-brand-lightOrange text-lg" aria-hidden="true"></i>
                        <span>¿Prefieres pedir desde el navegador?</span>
                      </h2>
                      <p class="text-brand-washDeep/85 text-xs sm:text-sm mt-1">
                        {hero.webOrderDescription}
                      </p>
                    </div>
                    <a
                      href={ORDERS_WEB_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-web-orders-link
                      data-web-orders-source="landing_hero"
                      class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-btn bg-white text-brand-orange font-bold text-sm hover:bg-brand-wash hover:shadow-glow-orange transition-all shrink-0 hover:-translate-y-0.5"
                    >
                      <i class="ri-shopping-bag-3-fill text-lg" aria-hidden="true"></i>
                      <span>{hero.webOrderCta}</span>
                      <i class="ri-arrow-right-line text-sm" aria-hidden="true"></i>
                    </a>
                  </div>
                </div>

                <!-- Descargar la App en tiendas -->
                <div class="mb-10">
                  <p class="text-xs uppercase tracking-wider text-brand-washDeep/85 font-bold mb-3.5">
                    O descarga la app oficial en tu celular:
                  </p>
                  <div class="flex flex-wrap items-center gap-4">
                    <a
                      href={PLAY_STORE_URL}
                      data-store-link="android"
                      data-store-source="landing"
                      aria-label="Descargar en Google Play"
                    >
                      <img
                        src={storeBadges.playStore}
                        alt="Google Play"
                        class="h-12 w-auto hover:scale-105 transition-transform"
                      />
                    </a>
                    <a
                      href={APP_STORE_URL}
                      data-store-link="ios"
                      data-store-source="landing"
                      aria-label="Descargar en App Store"
                    >
                      <img
                        src={storeBadges.appStore}
                        alt="App Store"
                        class="h-12 w-auto hover:scale-105 transition-transform"
                      />
                    </a>
                  </div>
                </div>

                <ul class="grid sm:grid-cols-3 gap-4">
                  {
                    features.map((feature) => (
                      <li class="bg-brand-dark/55 backdrop-blur-sm rounded-card p-4 border border-white/10">
                        <i
                          class={`${feature.icon} text-brand-lightOrange text-xl mb-2 block`}
                          aria-hidden="true"
                        />
                        <h3 class="text-white font-bold text-sm mb-1">{feature.title}</h3>
                        <p class="text-brand-washDeep/80 text-xs leading-relaxed">
                          {feature.description}
                        </p>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="reveal order-1 lg:order-2 flex justify-center">
                <div class="tilt-3d-stage" data-tilt-stage data-tilt-max="7">
                  <div class="tilt-3d-body relative float-soft" data-tilt-body>
                    <img
                      src={hero.image}
                      alt={hero.imageAlt}
                      class="relative w-full max-w-sm lg:max-w-md drop-shadow-2xl"
                      loading="eager"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>

    <AppLandingFooter />
  </div>

  <script>
    import '../scripts/app-device-redirect.ts';
    import { initStoreLinkTracking } from '../scripts/store-link-tracking.ts';

    initStoreLinkTracking();
  </script>
</BaseLayout>
