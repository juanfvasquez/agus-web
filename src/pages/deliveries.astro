---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { whatsappUrl, whatsappMessages, TAGLINE } from '../data/site';
import { deliveriesNav } from '../data/navigation';
import {
  benefits,
  platformFeatures,
  platformExtras,
  commissionOptions,
  onboardingSteps,
  deliveriesFaqs,
} from '../data/deliveries';
---

<BaseLayout
  title="Agus Deliveries - Vincula tu negocio"
  description="Conecta tu negocio con clientes de Agus App. Domicilios, logística incluida y solo pagas cuando vendes. Comisión del 18%."
>
  <Header currentPage="deliveries" navLinks={deliveriesNav} />

  <main>
    <section class="hero-agus section-agus border-b-4 border-brand-lightOrange">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 items-center">
          <div class="reveal">
            <p class="text-brand-lightOrange font-semibold text-sm uppercase tracking-widest mb-4">
              Agus Deliveries
            </p>
            <div class="accent-bar-light"></div>
            <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-extrabold leading-tight text-white mb-5">
              Conectamos tu negocio con clientes que ya buscan lo que vendes
            </h1>
            <p class="text-lg text-white/85 max-w-xl mb-3 leading-relaxed">
              Directo en su celular. Tú te enfocas en preparar los pedidos, nosotros nos encargamos
              del resto.
            </p>
            <p class="text-sm italic text-white/60 mb-8">"{TAGLINE}"</p>
            <a
              href={whatsappUrl(whatsappMessages.deliveries)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-agus bg-white text-brand-orange hover:bg-brand-wash"
            >
              <i class="ri-whatsapp-line text-lg"></i> Escríbenos por WhatsApp
            </a>
          </div>

          <div class="reveal flex justify-center lg:justify-end">
            <img
              src="/img/phone-app.png"
              alt="App de comercios Agus"
              class="max-w-xs w-full float-soft drop-shadow-2xl"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="beneficios" class="section-agus section-orange">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">¿Qué gana tu negocio?</h2>
          <p class="text-brand-secondary/70">
            Accede a una solución integral pensada para hacer crecer tus ventas digitales sin
            complicaciones.
          </p>
        </ScrollReveal>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 reveal-stagger">
          {
            benefits.map((benefit) => (
              <FeatureCard
                icon={benefit.icon}
                title={benefit.title}
                description={benefit.description}
                wide={benefit.wide}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section id="plataforma" class="section-agus surface-section border-y border-brand-orange/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">Tu Plataforma</h2>
          <p class="text-brand-secondary/70">
            La app de comercios de Agus te da control total sobre tu negocio digital. Fácil de usar,
            en tiempo real, siempre disponible.
          </p>
        </ScrollReveal>

        <div class="grid lg:grid-cols-3 gap-8 relative reveal-stagger">
          <div
            class="hidden lg:block absolute top-1/2 left-[16.66%] right-[16.66%] h-0.5 bg-gradient-to-r from-brand-orange/20 via-brand-orange to-brand-orange/20 -translate-y-1/2 z-0"
          >
          </div>
          {
            platformFeatures.map((feature) => (
              <div class="reveal relative z-10 bg-white p-6 rounded-card border border-brand-secondary/10 card-hover">
                <div class="h-10 w-10 bg-brand-orange/10 text-brand-orange rounded-btn flex items-center justify-center font-bold mb-4">
                  {feature.step}
                </div>
                <h3 class="text-lg font-bold mb-2">{feature.title}</h3>
                <p class="text-brand-secondary/65 text-sm">{feature.description}</p>
              </div>
            ))
          }
        </div>

        <div
          class="reveal mt-12 bg-brand-section p-8 rounded-card border border-brand-secondary/10 grid md:grid-cols-3 gap-6"
        >
          {
            platformExtras.map((extra) => (
              <div class="flex items-center gap-3">
                <i class:list={[`${extra.icon} text-3xl`, extra.color]} />
                <span class="text-sm font-medium">{extra.text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="modelo" class="section-agus section-wash-deep">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">Nuestro Modelo</h2>
          <p class="text-xl font-bold text-brand-orange">Solo pagas cuando vendes.</p>
        </ScrollReveal>

        <div
          class="reveal bg-brand-dark text-white rounded-card p-8 lg:p-12 border-2 border-brand-orange/30 shadow-glow-orange"
        >
          <div class="grid lg:grid-cols-3 gap-8 items-center">
            <div class="text-center lg:text-left">
              <span
                class="text-6xl font-black text-brand-orange"
                data-counter="18"
                data-counter-suffix="%">18%</span
              >
              <p class="text-lg font-medium text-gray-300 mt-2">
                de comisión sobre las ventas realizadas a través de la app.
              </p>
            </div>
            <div class="lg:col-span-2 grid sm:grid-cols-3 gap-4 text-center">
              <div class="p-4 bg-white/10 rounded-card">
                <i class="ri-close-circle-line text-2xl text-red-400"></i>
                <p class="text-sm mt-1">Sin mensualidades</p>
              </div>
              <div class="p-4 bg-white/10 rounded-card">
                <i class="ri-close-circle-line text-2xl text-red-400"></i>
                <p class="text-sm mt-1">Sin costos fijos</p>
              </div>
              <div class="p-4 bg-white/10 rounded-card">
                <i class="ri-close-circle-line text-2xl text-red-400"></i>
                <p class="text-sm mt-1">Sin sorpresas</p>
              </div>
            </div>
          </div>

          <hr class="my-8 border-gray-700" />

          <h3 class="text-lg font-bold mb-4 text-orange-200">Opciones para ajustar la comisión:</h3>
          <div class="grid md:grid-cols-3 gap-6 text-sm text-gray-300">
            {
              commissionOptions.map((option) => (
                <div class="bg-white/5 p-4 rounded-card border border-white/10">
                  <strong class="text-white block mb-1">{option.title}</strong>
                  {option.description}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="vinculacion" class="section-agus section-orange">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="section-title">Proceso de Vinculación</h2>
          <p class="text-brand-secondary/70">
            Unirte a Agus es rápido y sin complicaciones. Solo necesitas tener listas las fotos de
            tus productos y el logo de tu negocio.
          </p>
        </ScrollReveal>

        <div class="grid md:grid-cols-3 gap-8 relative reveal-stagger">
          <div
            class="hidden md:block absolute top-16 left-[20%] right-[20%] h-0.5 bg-gradient-to-r from-brand-orange/30 via-brand-orange to-brand-orange/30"
          >
          </div>
          {
            onboardingSteps.map((step) => (
              <div class="reveal bg-white p-8 rounded-card border border-brand-secondary/10 card-hover relative z-10">
                <span class="w-11 h-11 bg-brand-orange text-white rounded-btn flex items-center justify-center font-bold text-lg mb-6">
                  {step.step}
                </span>
                <h3 class="text-xl font-bold mb-3">{step.title}</h3>
                <p class="text-brand-secondary/65 text-sm">{step.description}</p>
              </div>
            ))
          }
        </div>

        <div
          class="reveal mt-16 bg-white p-8 rounded-card border-l-4 border-brand-orange max-w-2xl mx-auto text-center italic"
        >
          <i class="ri-double-quotes-l text-4xl text-brand-orange/30 mb-2 block"></i>
          <p class="text-brand-secondary/80 font-medium mb-3">
            "Desde que entramos a Agus, nuestros pedidos de domicilio aumentaron notablemente. La
            plataforma es muy fácil de manejar y los clientes están felices con el servicio."
          </p>
          <span class="text-xs text-brand-secondary/50 font-semibold uppercase tracking-wider">
            — Propietario, restaurante aliado de Agus
          </span>
        </div>
      </div>
    </section>

    <section id="faq" class="section-agus surface-section">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScrollReveal class="text-center mb-16">
          <h2 class="section-title">Preguntas Frecuentes</h2>
          <p class="text-brand-secondary/70">
            Resolvemos tus dudas sobre el servicio y funcionamiento de Agus App.
          </p>
        </ScrollReveal>

        <FAQ faqs={deliveriesFaqs} />
      </div>
    </section>

    <CTASection
      title="¿Listo para vender más con Agus?"
      subtitle="Vincula tu negocio hoy y empieza a recibir pedidos desde el primer día."
      message={whatsappMessages.deliveries}
    />
  </main>

  <Footer
    title="¿Listo para vender más?"
    subtitle="Contáctanos hoy y activa tu negocio en Agus App."
    ctaMessage={whatsappMessages.deliveries}
  />
</BaseLayout>
