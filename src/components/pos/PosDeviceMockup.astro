---
interface Props {
  imageSrc?: string;
  imageAlt?: string;
  badge?: string;
}

const {
  imageSrc = '/assets/home.webp',
  imageAlt = 'Panel de Agus POS',
  badge = 'En tiempo real',
} = Astro.props;
---

<div class="tilt-3d-stage relative max-w-sm mx-auto" data-tilt-stage data-tilt-max="7">
  <div class="tilt-3d-body relative" data-tilt-body>
    <div class="bg-brand-dark rounded-card p-3.5 shadow-elevated-lg border border-white/15">
      <div class="bg-brand-secondary rounded-[8px] overflow-hidden">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="w-full max-h-[280px] object-cover object-top"
          loading="eager"
        />
      </div>
      <div class="flex justify-center gap-1.5 mt-3">
        <span class="w-2 h-2 rounded-full bg-brand-orange"></span>
        <span class="w-2 h-2 rounded-full bg-white/25"></span>
        <span class="w-2 h-2 rounded-full bg-white/25"></span>
      </div>
    </div>

    <span
      class="absolute -top-3 -right-3 bg-brand-orange text-white text-xs font-bold px-3.5 py-1.5 rounded-btn shadow-glow-orange"
      style="transform: translateZ(30px);"
    >
      {badge}
    </span>
  </div>
</div>
