---
import { whatsappUrl, whatsappMessages } from '../data/site';
import { formatPrice } from '../data/pos';
import type { Plan } from '../data/pos';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
const waUrl = whatsappUrl(whatsappMessages.posPlan(plan.name));
const isPopular = Boolean(plan.popular);
---

<div
  class:list={[
    'reveal relative flex flex-col p-8 sm:p-9 rounded-card card-hover h-full',
    isPopular
      ? 'bg-brand-dark text-white shadow-elevated-lg lg:-translate-y-2'
      : 'spotlight-card bg-white text-brand-secondary shadow-elevated',
  ]}
>
  {
    isPopular && (
      <span class="absolute -top-3.5 left-8 bg-brand-orange text-white text-xs font-bold uppercase tracking-wider px-4 py-1 rounded-btn shadow-glow-orange">
        Más popular
      </span>
    )
  }

  <div class="mb-6 pt-1">
    <h3
      class:list={[
        'text-2xl font-extrabold',
        isPopular ? 'text-white' : 'text-brand-secondary',
      ]}
    >
      {plan.name}
    </h3>
    <p
      class:list={[
        'text-sm mt-1',
        isPopular ? 'text-brand-washDeep/80' : 'text-brand-secondary/75',
      ]}
    >
      {plan.tagline}
    </p>
  </div>

  <div class="mb-6 tabular-nums flex items-baseline gap-1.5">
    <span
      class:list={[
        'text-4xl sm:text-5xl font-extrabold tracking-tight',
        isPopular ? 'text-brand-lightOrange' : 'text-brand-orange',
      ]}
    >
      {formatPrice(plan.price)}
    </span>
    <span
      class:list={[
        'text-sm font-medium',
        isPopular ? 'text-brand-washDeep/70' : 'text-brand-secondary/65',
      ]}
    >
      COP / mes
    </span>
  </div>

  <p
    class:list={[
      'text-xs mb-6 pb-6 border-b',
      isPopular
        ? 'text-brand-washDeep/80 border-white/10'
        : 'text-brand-secondary/75 border-brand-secondary/10',
    ]}
  >
    Ideal para:{' '}
    <strong class:list={['font-bold', isPopular ? 'text-white' : 'text-brand-secondary']}>
      {plan.idealFor}
    </strong>
  </p>

  <ul class="space-y-3.5 mb-9 flex-1">
    {
      plan.features.map((feature) => (
        <li
          class:list={[
            'flex items-start gap-3 text-sm leading-relaxed',
            isPopular ? 'text-brand-washDeep/90' : 'text-brand-secondary/85',
          ]}
        >
          <span
            class:list={[
              'w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5',
              isPopular
                ? 'bg-brand-orange text-white'
                : 'bg-brand-orange/15 text-brand-orange',
            ]}
          >
            <i class="ri-check-line text-xs font-bold" aria-hidden="true" />
          </span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'w-full text-center py-3.5 px-6 rounded-btn font-bold transition-all duration-300 ease-agus flex items-center justify-center gap-2',
      isPopular
        ? 'bg-brand-orange text-white hover:bg-brand-darkOrange shadow-glow-orange'
        : 'bg-brand-ink text-white hover:bg-brand-orange',
    ]}
  >
    <i class="ri-whatsapp-line text-xl" aria-hidden="true" />
    <span>Elegir plan {plan.name}</span>
  </a>
</div>
