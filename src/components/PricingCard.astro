---
import { whatsappUrl, whatsappMessages } from '../data/site';
import { formatPrice } from '../data/pos';
import type { Plan } from '../data/pos';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
const waUrl = whatsappUrl(whatsappMessages.posPlan(plan.name));
---

<div
  class:list={[
    'reveal relative flex flex-col p-8 rounded-card border bg-white card-hover h-full',
    plan.popular
      ? 'border-brand-orange border-2 shadow-md'
      : 'border-brand-secondary/10',
  ]}
>
  {
    plan.popular && (
      <span class="absolute -top-3 left-6 bg-brand-orange text-white text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-btn">
        Más popular
      </span>
    )
  }

  <div class="mb-6 pt-2">
    <h3 class="text-2xl font-bold text-brand-secondary">{plan.name}</h3>
    <p class="text-sm text-brand-secondary/60 mt-1">{plan.tagline}</p>
  </div>

  <div class="mb-6">
    <span class="text-4xl font-bold text-brand-orange">{formatPrice(plan.price)}</span>
    <span class="text-brand-secondary/50 text-sm">/mes</span>
  </div>

  <p class="text-xs text-brand-secondary/60 mb-6 pb-6 border-b border-brand-secondary/10">
    Ideal para: <strong class="text-brand-secondary">{plan.idealFor}</strong>
  </p>

  <ul class="space-y-3 mb-8 flex-1">
    {
      plan.features.map((feature) => (
        <li class="flex items-start gap-3 text-sm text-brand-secondary/80">
          <i class="ri-check-line text-brand-orange text-lg shrink-0 mt-0.5" />
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'w-full text-center py-3 rounded-btn font-semibold transition-colors flex items-center justify-center gap-2',
      plan.popular
        ? 'bg-brand-orange text-white hover:bg-brand-darkOrange'
        : 'bg-brand-secondary text-white hover:bg-brand-secondary/90',
    ]}
  >
    <i class="ri-whatsapp-line text-xl" />
    Elegir {plan.name}
  </a>
</div>
