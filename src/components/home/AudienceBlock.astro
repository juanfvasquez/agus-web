---
import { whatsappUrl, whatsappMessages } from '../../data/site';

interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  features: Feature[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  cta?: { label: string; whatsappKey: keyof typeof whatsappMessages };
  variant?: 'default' | 'alt' | 'highlight';
}

const {
  id,
  title,
  description,
  image,
  imageAlt,
  imagePosition = 'left',
  features,
  primaryCta,
  secondaryCta,
  cta,
  variant = 'default',
} = Astro.props;

const imageFirst = imagePosition === 'left';
const bgClass =
  variant === 'highlight'
    ? 'section-orange'
    : variant === 'alt'
      ? 'surface-section'
      : 'bg-white';
---

<section id={id} class:list={['section-agus', bgClass]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {
        imageFirst && (
          <div class="reveal">
            <div class="relative">
              <div class="absolute -inset-3 bg-brand-orange/10 rounded-card -z-10" />
              <img
                src={image}
                alt={imageAlt}
                class="w-full max-w-md mx-auto rounded-card shadow-glow-orange"
                loading="lazy"
              />
            </div>
          </div>
        )
      }

      <div class="reveal">
        <div class="accent-bar"></div>
        <h2 class="section-title">{title}</h2>
        <p class="text-brand-secondary/70 leading-relaxed mb-8">{description}</p>

        <div class="grid sm:grid-cols-2 gap-6 mb-8">
          {
            features.map((feature) => (
              <div class="bg-white/80 rounded-card p-4 border border-brand-orange/10">
                <i class:list={[feature.icon, 'text-2xl text-brand-orange mb-2 block']} />
                <h3 class="font-semibold text-brand-secondary mb-1">{feature.title}</h3>
                {feature.description && (
                  <p class="text-sm text-brand-secondary/60">{feature.description}</p>
                )}
              </div>
            ))
          }
        </div>

        {
          primaryCta && (
            <div class="flex flex-wrap gap-3">
              <a href={primaryCta.href} class="btn-agus">
                {primaryCta.label}
                <i class="ri-arrow-right-line"></i>
              </a>
              {secondaryCta && (
                <a href={secondaryCta.href} class="btn-agus-outline">
                  {secondaryCta.label}
                </a>
              )}
            </div>
          )
        }

        {
          cta && (
            <a
              href={whatsappUrl(whatsappMessages[cta.whatsappKey])}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-agus"
            >
              <i class="ri-whatsapp-line"></i>
              {cta.label}
            </a>
          )
        }
      </div>

      {
        !imageFirst && (
          <div class="reveal">
            <div class="relative">
              <div class="absolute -inset-3 bg-brand-orange/10 rounded-card -z-10" />
              <img
                src={image}
                alt={imageAlt}
                class="w-full max-w-md mx-auto rounded-card shadow-glow-orange"
                loading="lazy"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
