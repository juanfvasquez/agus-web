---
import { whatsappUrl, whatsappMessages } from '../../data/site';

interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  features: Feature[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  cta?: { label: string; whatsappKey: keyof typeof whatsappMessages };
  variant?: 'default' | 'alt' | 'highlight';
}

const {
  id,
  title,
  description,
  image,
  imageAlt,
  imagePosition = 'left',
  features,
  primaryCta,
  secondaryCta,
  cta,
  variant = 'default',
} = Astro.props;

const imageFirst = imagePosition === 'left';
const bgClass =
  variant === 'highlight'
    ? 'section-orange'
    : variant === 'alt'
      ? 'surface-section'
      : 'bg-white';

const badgeTitle = imageFirst ? 'Canal de ventas activo' : '100% del domicilio para ti';
const badgeSub = imageFirst ? 'Pagos lunes y jueves' : 'Conéctate en tu propio horario';
const badgeIcon = imageFirst ? 'ri-store-2-fill' : 'ri-e-bike-2-fill';
---

<section id={id} class:list={['section-agus', bgClass]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {
        imageFirst && (
          <div class="reveal">
            <div class="tilt-3d-stage max-w-md mx-auto relative" data-tilt-stage data-tilt-max="5">
              <div class="tilt-3d-body relative" data-tilt-body>
                <img
                  src={image}
                  alt={imageAlt}
                  class="w-full rounded-card shadow-elevated-lg"
                  loading="lazy"
                />
                <div
                  class="hidden sm:flex items-center gap-3 bg-brand-dark/95 text-white px-4 py-3 rounded-card shadow-elevated-lg absolute -bottom-5 -right-4"
                  style="transform: translateZ(32px);"
                >
                  <div class="w-9 h-9 rounded-btn bg-brand-orange flex items-center justify-center text-white shrink-0">
                    <i class={badgeIcon} aria-hidden="true" />
                  </div>
                  <div>
                    <p class="text-xs font-bold text-white leading-tight">{badgeTitle}</p>
                    <p class="text-[11px] text-brand-washDeep/80">{badgeSub}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )
      }

      <div class="reveal">
        <h2 class="section-title">{title}</h2>
        <p class="text-brand-secondary/80 text-base sm:text-lg leading-relaxed mb-8 max-w-xl">
          {description}
        </p>

        <div class="grid sm:grid-cols-2 gap-5 mb-9">
          {
            features.map((feature) => (
              <div class="spotlight-card bg-white rounded-card p-6 shadow-elevated">
                <div class="w-11 h-11 rounded-btn bg-brand-washDeep text-brand-orange flex items-center justify-center text-xl mb-3.5">
                  <i class={feature.icon} aria-hidden="true" />
                </div>
                <h3 class="font-bold text-brand-secondary text-base mb-1.5">{feature.title}</h3>
                {feature.description && (
                  <p class="text-sm text-brand-secondary/80 leading-relaxed">{feature.description}</p>
                )}
              </div>
            ))
          }
        </div>

        {
          primaryCta && (
            <div class="flex flex-wrap gap-3.5">
              <a href={primaryCta.href} class="btn-agus">
                <span>{primaryCta.label}</span>
                <i class="ri-arrow-right-line" aria-hidden="true"></i>
              </a>
              {secondaryCta && (
                <a href={secondaryCta.href} class="btn-agus-outline">
                  <span>{secondaryCta.label}</span>
                </a>
              )}
            </div>
          )
        }

        {
          cta && (
            <a
              href={whatsappUrl(whatsappMessages[cta.whatsappKey])}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-agus"
            >
              <i class="ri-whatsapp-line text-lg" aria-hidden="true"></i>
              <span>{cta.label}</span>
            </a>
          )
        }
      </div>

      {
        !imageFirst && (
          <div class="reveal">
            <div class="tilt-3d-stage max-w-md mx-auto relative" data-tilt-stage data-tilt-max="5">
              <div class="tilt-3d-body relative" data-tilt-body>
                <img
                  src={image}
                  alt={imageAlt}
                  class="w-full rounded-card shadow-elevated-lg"
                  loading="lazy"
                />
                <div
                  class="hidden sm:flex items-center gap-3 bg-brand-dark/95 text-white px-4 py-3 rounded-card shadow-elevated-lg absolute -bottom-5 -left-4"
                  style="transform: translateZ(32px);"
                >
                  <div class="w-9 h-9 rounded-btn bg-brand-orange flex items-center justify-center text-white shrink-0">
                    <i class={badgeIcon} aria-hidden="true" />
                  </div>
                  <div>
                    <p class="text-xs font-bold text-white leading-tight">{badgeTitle}</p>
                    <p class="text-[11px] text-brand-washDeep/80">{badgeSub}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
