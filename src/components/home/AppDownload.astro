---
import type { appSection } from '../../data/home';
import { APP_STORE_URL, PLAY_STORE_URL, ORDERS_WEB_URL } from '../../data/site';

interface Props {
  data: typeof appSection;
}

const { data } = Astro.props;
---

<section id={data.id} class="section-agus bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      <!-- Left interactive /app hub showcase (replaces old QR code) -->
      <div class="reveal lg:col-span-5">
        <div
          class="tilt-3d-stage"
          data-tilt-stage
          data-tilt-max="5"
        >
          <div
            class="tilt-3d-body bg-brand-dark text-white rounded-card p-7 sm:p-8 shadow-elevated-lg relative overflow-hidden"
            data-tilt-body
          >
            <div class="flex items-center justify-between gap-4 pb-6 mb-6 border-b border-white/10">
              <div class="flex items-center gap-3">
                <img
                  src="/assets/app-icon.png"
                  alt="Icono de Agus App"
                  class="w-12 h-12 rounded-btn shadow-glow-orange"
                  loading="lazy"
                />
                <div>
                  <h3 class="text-lg font-bold text-white leading-snug">Agus Pedidos</h3>
                  <p class="text-xs text-brand-washDeep/80">Tiendas oficiales y pedidos en línea</p>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-emerald-500/20 text-emerald-300 px-3 py-1 rounded-btn">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                En vivo
              </span>
            </div>

            <!-- Live order route preview -->
            <div class="bg-white/5 rounded-btn p-4 mb-6">
              <div class="flex items-center justify-between text-xs text-brand-washDeep/90 mb-3">
                <span class="font-semibold text-white">Restaurante → Tu puerta</span>
                <span class="tabular-nums text-brand-lightOrange font-bold">~15 min</span>
              </div>
              <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden mb-3">
                <div class="w-3/4 h-full bg-brand-orange rounded-full"></div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-brand-washDeep/75">
                <span>1. Elige tu comercio</span>
                <span>2. Pide en App o Web</span>
                <span>3. Recibe en casa</span>
              </div>
            </div>

            <!-- Direct actions to /app and web orders -->
            <div class="space-y-3">
              <a
                href={data.ctaHref}
                class="w-full btn-agus justify-between px-5 py-3.5 text-sm"
              >
                <span class="flex items-center gap-2.5">
                  <i class="ri-compass-3-line text-lg" aria-hidden="true"></i>
                  <span>Abrir centro de descargas y pedidos (/app)</span>
                </span>
                <i class="ri-arrow-right-line text-base" aria-hidden="true"></i>
              </a>

              <a
                href={ORDERS_WEB_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-web-orders-link
                data-web-orders-source="home_app_section"
                class="w-full inline-flex items-center justify-between px-5 py-3 rounded-btn bg-white/10 hover:bg-white/15 text-white text-sm font-semibold transition-colors"
              >
                <span class="flex items-center gap-2.5">
                  <i class="ri-computer-line text-brand-lightOrange text-lg" aria-hidden="true"></i>
                  <span>Pedir ahora desde el navegador web</span>
                </span>
                <i class="ri-external-link-line text-brand-washDeep/80" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right content & store links -->
      <div class="reveal lg:col-span-7">
        <h2 class="section-title">{data.title}</h2>
        <p class="text-brand-secondary/80 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl">
          {data.description}
        </p>

        <div class="grid sm:grid-cols-3 gap-4 mb-8">
          {
            data.highlights.map((item) => (
              <div class="spotlight-card bg-brand-wash rounded-card p-4">
                <i
                  class:list={[
                    item.icon.toLowerCase(),
                    'text-2xl text-brand-orange mb-2 block',
                  ]}
                  aria-hidden="true"
                />
                <h3 class="text-sm font-bold text-brand-secondary mb-1">{item.title}</h3>
                <p class="text-xs text-brand-secondary/75 leading-relaxed">{item.description}</p>
              </div>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a href={data.ctaHref} class="btn-agus">
            <i class="ri-smartphone-line text-lg" aria-hidden="true"></i>
            <span>{data.ctaLabel}</span>
            <i class="ri-arrow-right-line" aria-hidden="true"></i>
          </a>

          <div class="flex items-center gap-3">
            <a
              href={PLAY_STORE_URL}
              data-store-link="android"
              data-store-source="home"
              aria-label="Descargar en Google Play"
              class="transition-transform hover:scale-105"
            >
              <img
                src={data.playStore}
                alt="Disponible en Google Play"
                class="h-11 w-auto"
                loading="lazy"
              />
            </a>
            <a
              href={APP_STORE_URL}
              data-store-link="ios"
              data-store-source="home"
              aria-label="Descargar en App Store"
              class="transition-transform hover:scale-105"
            >
              <img
                src={data.appStore}
                alt="Disponible en App Store"
                class="h-11 w-auto"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initStoreLinkTracking } from '../../scripts/store-link-tracking.ts';

  initStoreLinkTracking();
</script>
