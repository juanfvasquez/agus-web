---
import type { appSection } from '../../data/home';
import { APP_STORE_URL, PLAY_STORE_URL } from '../../data/site';

interface Props {
  data: typeof appSection;
}

const { data } = Astro.props;
---

<section id={data.id} class="section-agus bg-white relative overflow-hidden">
  <div class="absolute left-0 top-0 bottom-0 w-2 bg-brand-orange hidden lg:block" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal flex justify-center">
        <div class="bg-brand-wash rounded-card p-8 border border-brand-orange/20 shadow-glow-orange">
          <img
            src={data.qrImage}
            alt="Código QR para descargar Agus App"
            class="w-56 h-auto"
            loading="lazy"
          />
        </div>
      </div>

      <div class="reveal">
        <div class="accent-bar"></div>
        <h2 class="section-title">{data.title}</h2>
        <p class="text-brand-secondary/70 leading-relaxed mb-8">{data.description}</p>
        <div class="flex flex-wrap gap-4">
          <a
            href={PLAY_STORE_URL}
            data-store-link="android"
            data-store-source="home"
            aria-label="Descargar en Google Play"
          >
            <img
              src={data.playStore}
              alt="Google Play"
              class="h-12 w-auto hover:scale-105 transition-transform"
              loading="lazy"
            />
          </a>
          <a
            href={APP_STORE_URL}
            data-store-link="ios"
            data-store-source="home"
            aria-label="Descargar en App Store"
          >
            <img
              src={data.appStore}
              alt="App Store"
              class="h-12 w-auto hover:scale-105 transition-transform"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initStoreLinkTracking } from '../../scripts/store-link-tracking.ts';

  initStoreLinkTracking();
</script>
