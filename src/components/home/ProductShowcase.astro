---
import type { productShowcase } from '../../data/home';

interface Props {
  data: typeof productShowcase;
}

const { data } = Astro.props;
---

<section id={data.id} class="section-agus section-wash-deep">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <h2 class="section-title">{data.title}</h2>
      <p class="text-brand-secondary/80 text-base sm:text-lg">{data.subtitle}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 reveal-stagger">
      {
        data.products.map((product, idx) => {
          const isDark = idx === 1;
          return (
            <a
              href={product.href}
              class:list={[
                'reveal group rounded-card p-8 sm:p-10 card-hover flex flex-col justify-between relative overflow-hidden',
                isDark
                  ? 'bg-brand-dark text-white shadow-elevated-lg'
                  : 'spotlight-card bg-white text-brand-secondary shadow-elevated',
              ]}
            >
              <div class="relative z-10">
                <div class="flex items-start justify-between mb-6">
                  <div class="w-14 h-14 bg-brand-orange text-white rounded-card flex items-center justify-center text-2xl shadow-glow-orange group-hover:scale-105 transition-transform duration-300 ease-agus">
                    <i class={product.icon} aria-hidden="true" />
                  </div>
                  <span
                    class:list={[
                      'text-xs font-extrabold uppercase tracking-wider px-3.5 py-1.5 rounded-btn',
                      isDark
                        ? 'bg-white/10 text-brand-lightOrange'
                        : 'bg-brand-washDeep text-brand-orange',
                    ]}
                  >
                    {product.badge}
                  </span>
                </div>

                <h3
                  class:list={[
                    'text-2xl sm:text-3xl font-extrabold mb-2 transition-colors',
                    isDark
                      ? 'text-white group-hover:text-brand-lightOrange'
                      : 'text-brand-secondary group-hover:text-brand-orange',
                  ]}
                >
                  {product.name}
                </h3>
                <p
                  class:list={[
                    'font-bold text-sm mb-4',
                    isDark ? 'text-brand-lightOrange' : 'text-brand-orange',
                  ]}
                >
                  {product.hook}
                </p>
                <p
                  class:list={[
                    'leading-relaxed mb-6',
                    isDark ? 'text-brand-washDeep/80' : 'text-brand-secondary/80',
                  ]}
                >
                  {product.description}
                </p>

                <!-- Mini contextual live status bar inside each product card -->
                {idx === 0 ? (
                  <div class="bg-brand-wash rounded-btn p-4 mb-6 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulseSoft" />
                      <span class="text-xs font-bold text-brand-secondary">
                        Red de domiciliarios integrada
                      </span>
                    </div>
                    <span class="text-xs font-bold text-brand-orange tabular-nums">
                      $0 costo fijo
                    </span>
                  </div>
                ) : (
                  <div class="bg-white/5 border border-white/10 rounded-btn p-4 mb-6 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                      <i class="ri-layout-masonry-line text-brand-lightOrange" aria-hidden="true" />
                      <span class="text-xs font-bold text-white">
                        Mesas, comandas, caja e inventario
                      </span>
                    </div>
                    <span class="text-xs font-bold text-emerald-400">En la nube</span>
                  </div>
                )}

                {product.highlights && (
                  <ul
                    class:list={[
                      'space-y-2.5 mb-8 pt-5 border-t',
                      isDark ? 'border-white/10' : 'border-brand-secondary/10',
                    ]}
                  >
                    {product.highlights.map((item) => (
                      <li
                        class:list={[
                          'flex items-center gap-2.5 text-sm font-medium',
                          isDark ? 'text-brand-washDeep/90' : 'text-brand-secondary/85',
                        ]}
                      >
                        <i
                          class="ri-checkbox-circle-fill text-brand-orange text-base shrink-0"
                          aria-hidden="true"
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <div class="relative z-10 pt-2">
                <span
                  class:list={[
                    'inline-flex items-center gap-2 font-bold group-hover:gap-3.5 transition-all',
                    isDark ? 'text-brand-lightOrange' : 'text-brand-orange',
                  ]}
                >
                  <span>Explorar {product.name}</span>
                  <i class="ri-arrow-right-line" aria-hidden="true" />
                </span>
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- Direct banner to /app for customers -->
    <div class="reveal mt-10 bg-white rounded-card p-6 sm:p-8 shadow-elevated flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 text-center sm:text-left flex-col sm:flex-row">
        <div class="w-12 h-12 rounded-btn bg-brand-orange text-white flex items-center justify-center text-2xl shrink-0 shadow-glow-orange">
          <i class="ri-shopping-bag-3-line" aria-hidden="true"></i>
        </div>
        <div>
          <h3 class="text-lg font-extrabold text-brand-secondary">
            ¿Quieres pedir un domicilio ahora mismo?
          </h3>
          <p class="text-sm text-brand-secondary/80">
            Accede a nuestra web de pedidos o descarga la aplicación para iOS y Android desde nuestra página oficial de descargas.
          </p>
        </div>
      </div>
      <a href="/app" class="btn-agus shrink-0">
        <span>Ir a /app</span>
        <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
