---
import { whatsappUrl, whatsappMessages } from '../../data/site';
import ThreeHeroScene from '../ThreeHeroScene.astro';
import type { hero } from '../../data/home';

interface Props {
  data: typeof hero;
}

const { data } = Astro.props;
---

<section id="hero" class="hero-agus section-agus min-h-[90vh] flex items-center">
  <ThreeHeroScene />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid lg:grid-cols-[1.08fr_0.92fr] gap-12 lg:gap-16 items-center">
      <div class="reveal order-2 lg:order-1">
        <h1
          class="text-3xl sm:text-5xl lg:text-[3.4rem] font-extrabold leading-[1.08] text-white mb-6"
        >
          {data.title}
        </h1>
        <p class="text-lg sm:text-xl text-white/90 leading-relaxed mb-4 max-w-xl">
          {data.subtitle}
        </p>
        <p class="text-sm font-medium text-brand-washDeep/85 mb-9 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulseSoft" aria-hidden="true"></span>
          <span>{data.tagline} — Plataforma activa en iOS, Android y Web</span>
        </p>

        <div class="flex flex-wrap items-center gap-3.5 mb-12">
          <a
            href="/app"
            class="btn-agus bg-white text-brand-orange hover:bg-brand-wash hover:text-brand-darkOrange shadow-glow-orange-lg"
          >
            <i class="ri-shopping-bag-3-fill text-lg" aria-hidden="true"></i>
            <span>Pedir a domicilio / App</span>
            <i class="ri-arrow-right-up-line text-base" aria-hidden="true"></i>
          </a>
          <a
            href={whatsappUrl(whatsappMessages.general)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-agus-ghost"
          >
            <i class="ri-whatsapp-line text-lg" aria-hidden="true"></i>
            <span>Vincular mi negocio</span>
          </a>
        </div>

        <dl
          class="grid grid-cols-3 gap-4 sm:gap-6 pt-6 border-t border-white/15 max-w-lg"
        >
          {
            data.stats.map((stat) => (
              <div>
                <dt class="text-white font-extrabold text-lg sm:text-xl">{stat.value}</dt>
                <dd class="text-brand-washDeep/80 text-xs sm:text-sm mt-0.5">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reveal order-1 lg:order-2 flex justify-center lg:justify-end">
        <div
          class="tilt-3d-stage relative max-w-xs sm:max-w-sm w-full py-4"
          data-tilt-stage
          data-tilt-max="7"
        >
          <div class="tilt-3d-body relative" data-tilt-body>
            <img
              src={data.image}
              alt={data.imageAlt}
              class="relative w-full h-auto float-soft drop-shadow-2xl mx-auto"
              loading="eager"
            />

            <!-- Floating live order telemetry badge -->
            <div
              class="hidden sm:flex items-center gap-3 bg-brand-dark/90 backdrop-blur-md text-white px-4 py-3 rounded-card shadow-elevated-lg absolute -left-8 top-12 animate-floatDelayed"
              style="transform: translateZ(36px);"
            >
              <div class="w-9 h-9 rounded-btn bg-brand-orange flex items-center justify-center text-white shrink-0">
                <i class="ri-e-bike-2-fill text-lg" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-xs font-bold text-white leading-tight">Pedido en camino</p>
                <p class="text-[11px] text-brand-washDeep/80">Llegada estimada • 12 min</p>
              </div>
            </div>

            <!-- Floating direct /app shortcut pill -->
            <a
              href="/app"
              class="hidden sm:flex items-center gap-2.5 bg-white text-brand-dark px-4 py-2.5 rounded-card shadow-elevated-lg absolute -right-4 bottom-10 hover:scale-105 transition-transform"
              style="transform: translateZ(44px);"
            >
              <span class="w-7 h-7 rounded-btn bg-brand-orange/15 text-brand-orange flex items-center justify-center">
                <i class="ri-smartphone-line text-base" aria-hidden="true"></i>
              </span>
              <div class="text-left">
                <p class="text-xs font-bold text-brand-dark leading-tight">App & Pedidos Web</p>
                <p class="text-[11px] text-brand-orange font-semibold">Abrir /app →</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
