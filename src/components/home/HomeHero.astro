---
import { whatsappUrl, whatsappMessages } from '../../data/site';
import type { hero } from '../../data/home';

interface Props {
  data: typeof hero;
}

const { data } = Astro.props;
---

<section id="hero" class="hero-agus section-agus min-h-[88vh] flex items-center">
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-brand-lightOrange/20 rounded-full blur-3xl"></div>
    <div
      class="absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-center">
      <div class="reveal order-2 lg:order-1">
        <p class="text-brand-lightOrange font-semibold text-sm uppercase tracking-widest mb-3">
          {data.tagline}
        </p>
        <div class="accent-bar-light"></div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-[3.25rem] font-extrabold leading-tight text-white mb-5">
          {data.title}
        </h1>
        <p class="text-lg text-white/85 leading-relaxed mb-8 max-w-xl">
          {data.subtitle}
        </p>

        <div class="flex flex-wrap gap-3 mb-10">
          <a
            href={whatsappUrl(whatsappMessages.general)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-agus bg-white text-brand-orange hover:bg-brand-wash hover:text-brand-darkOrange shadow-glow-orange-lg"
          >
            <i class="ri-whatsapp-line text-lg"></i> Escríbenos por WhatsApp
          </a>
          <a href="#products" class="btn-agus-ghost">
            Ver soluciones <i class="ri-arrow-down-line"></i>
          </a>
        </div>

        <div class="flex flex-wrap gap-6">
          {
            data.stats.map((stat) => (
              <div class="border-l-2 border-white/40 pl-4">
                <p class="text-white font-bold text-lg">{stat.value}</p>
                <p class="text-white/60 text-sm">{stat.label}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="reveal order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative max-w-xs sm:max-w-sm w-full">
          <div
            class="absolute inset-0 bg-white/20 rounded-full blur-3xl scale-110"
            aria-hidden="true"
          >
          </div>
          <img
            src={data.image}
            alt={data.imageAlt}
            class="relative w-full h-auto float-soft drop-shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
