---
interface Props {
  icon: string;
  title: string;
  description: string;
  wide?: boolean;
}

const { icon, title, description, wide = false } = Astro.props;
---

<div
  class:list={[
    'reveal p-6 bg-white rounded-card border border-brand-secondary/10 card-hover',
    wide && 'md:col-span-2 lg:col-span-2',
  ]}
>
  <div
    class="w-11 h-11 bg-brand-orange/10 text-brand-orange rounded-btn flex items-center justify-center text-xl mb-4"
  >
    <i class={icon}></i>
  </div>
  <h3 class="text-lg font-semibold text-brand-secondary mb-2">{title}</h3>
  <p class="text-brand-secondary/65 text-sm leading-relaxed">{description}</p>
</div>
