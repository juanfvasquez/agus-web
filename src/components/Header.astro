---
import {
  whatsappUrl,
  whatsappMessages,
  WHATSAPP_DISPLAY,
  productLinks,
  type ProductPage,
} from '../data/site';
import { homeNav } from '../data/navigation';
import type { NavLink } from '../data/site';

interface Props {
  currentPage: ProductPage;
  navLinks?: NavLink[];
  whatsappMessage?: string;
}

const { currentPage, navLinks = [], whatsappMessage } = Astro.props;

const pageNav =
  currentPage === 'home'
    ? homeNav
    : navLinks.length > 0
      ? [{ href: '/', label: 'Inicio' }, ...navLinks]
      : [{ href: '/', label: 'Inicio' }];

const defaultMessage =
  currentPage === 'pos'
    ? whatsappMessages.pos
    : currentPage === 'deliveries'
      ? whatsappMessages.deliveries
      : whatsappMessages.general;

const waUrl = whatsappUrl(whatsappMessage ?? defaultMessage);
---

<header
  data-header
  class="sticky top-0 z-50 bg-brand-orange text-white border-b border-white/15 transition-all duration-300 ease-agus"
>
  <div
    class="header-inner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[72px] flex items-center justify-between gap-4 transition-all duration-300 ease-agus"
  >
    <div class="flex items-center gap-3 min-w-0">
      <a href="/" class="flex items-center shrink-0" aria-label="Agus App - Inicio">
        <img src="/assets/white-logo-agus.png" alt="Agus App" class="h-11 w-auto mr-3" />
      </a>

      <div class="hidden md:flex items-center bg-black/15 rounded-btn p-1 shrink-0 gap-0.5">
        {
          productLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-1.5 rounded-[7px] text-xs font-bold tracking-wide transition-all duration-200',
                currentPage === link.id
                  ? 'bg-white text-brand-orange shadow-sm'
                  : 'text-white/90 hover:text-white hover:bg-white/15',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <nav class="hidden xl:flex items-center gap-6 text-sm font-medium text-white/90" aria-label="Navegación principal">
      {
        pageNav.map((link) => (
          <a href={link.href} class="hover:text-white transition-colors whitespace-nowrap">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5 shrink-0">
      <a
        href="/app"
        class="hidden sm:inline-flex items-center gap-1.5 bg-white/15 hover:bg-white/25 text-white font-semibold text-sm px-3.5 py-2 rounded-btn transition-colors"
      >
        <i class="ri-shopping-bag-3-line text-base" aria-hidden="true"></i>
        <span>Pedir</span>
      </a>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 bg-white text-brand-orange font-bold text-sm px-4 py-2 rounded-btn hover:bg-brand-wash transition-colors shadow-sm tabular-nums"
      >
        <i class="ri-whatsapp-line text-lg" aria-hidden="true"></i>
        <span class="hidden lg:inline">{WHATSAPP_DISPLAY}</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="xl:hidden p-2 rounded-btn border border-white/30 hover:bg-white/15 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <i class="ri-menu-3-line text-xl text-white" id="menu-icon-open" aria-hidden="true"></i>
        <i class="ri-close-line text-xl text-white hidden" id="menu-icon-close" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="xl:hidden hidden border-t border-white/15 bg-brand-dark/95 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 py-5 space-y-4">
      <div class="grid grid-cols-3 gap-2">
        {
          productLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'text-center px-3 py-2.5 rounded-btn text-xs font-bold uppercase tracking-wide transition-colors',
                currentPage === link.id
                  ? 'bg-brand-orange text-white'
                  : 'bg-white/10 text-white hover:bg-white/20',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <nav class="grid grid-cols-2 gap-2" aria-label="Menú móvil">
        {
          pageNav.map((link) => (
            <a
              href={link.href}
              class="px-3.5 py-2.5 rounded-btn bg-white/5 text-sm font-medium text-white hover:bg-white/15 mobile-nav-link"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="grid sm:grid-cols-2 gap-2.5 pt-1">
        <a
          href="/app"
          class="inline-flex w-full items-center justify-center gap-2 bg-brand-orange text-white font-bold px-5 py-3 rounded-btn"
        >
          <i class="ri-shopping-bag-3-line text-lg" aria-hidden="true"></i>
          <span>Pedir a domicilio (/app)</span>
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 bg-white text-brand-orange font-bold px-5 py-3 rounded-btn"
        >
          <i class="ri-whatsapp-line text-lg" aria-hidden="true"></i>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
