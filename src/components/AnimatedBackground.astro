---
interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---

<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
  {
    variant === 'light' ? (
      <>
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-white/10 rounded-full blur-3xl animate-blob" />
        <div class="absolute -bottom-32 -left-32 w-[28rem] h-[28rem] bg-amber-400/20 rounded-full blur-3xl animate-blob [animation-delay:2s]" />
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[32rem] h-[32rem] bg-orange-300/10 rounded-full blur-3xl animate-blob [animation-delay:4s]" />
      </>
    ) : (
      <>
        <div class="absolute -top-32 -right-32 w-[30rem] h-[30rem] bg-brand-orange/20 rounded-full blur-3xl animate-blob" />
        <div class="absolute -bottom-40 -left-40 w-[28rem] h-[28rem] bg-orange-600/10 rounded-full blur-3xl animate-blob [animation-delay:3s]" />
        <div class="absolute top-1/3 right-1/4 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl animate-blob [animation-delay:1.5s]" />
      </>
    )
  }
</div>
