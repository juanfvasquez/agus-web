---
interface Props {
  variant?: 'warm' | 'dark';
}

const { variant = 'warm' } = Astro.props;
---

<div
  class="three-hero-wrapper absolute inset-0 overflow-hidden pointer-events-none select-none"
  data-three-hero
  data-three-variant={variant}
  aria-hidden="true"
>
  <canvas class="three-hero-canvas w-full h-full block opacity-0 transition-opacity duration-700"></canvas>
</div>

<script>
  import {
    WebGLRenderer,
    Scene,
    PerspectiveCamera,
    Group,
    AmbientLight,
    PointLight,
    IcosahedronGeometry,
    MeshBasicMaterial,
    Mesh,
    TorusGeometry,
    Vector3,
    SphereGeometry,
    RingGeometry,
    DoubleSide,
    QuadraticBezierCurve3,
    BufferGeometry,
    LineBasicMaterial,
    Line,
    BufferAttribute,
    PointsMaterial,
    Points,
  } from 'three';

  function initThreeHeroes() {
    const wrappers = document.querySelectorAll<HTMLElement>('[data-three-hero]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.initialized === 'true') return;
      wrapper.dataset.initialized = 'true';

      const canvas = wrapper.querySelector<HTMLCanvasElement>('.three-hero-canvas');
      if (!canvas) return;

      let renderer: WebGLRenderer;
      try {
        renderer = new WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: 'high-performance',
        });
      } catch {
        return;
      }

      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new Scene();
      const camera = new PerspectiveCamera(45, 1, 0.1, 100);
      camera.position.set(0, 0, 14);

      const rootGroup = new Group();
      scene.add(rootGroup);

      const ambientLight = new AmbientLight(0xffffff, 0.9);
      scene.add(ambientLight);

      const pointLight1 = new PointLight(0xff9e6d, 2.4, 30);
      pointLight1.position.set(6, 5, 8);
      scene.add(pointLight1);

      const pointLight2 = new PointLight(0xeb5d1e, 1.8, 30);
      pointLight2.position.set(-7, -4, 6);
      scene.add(pointLight2);

      const geoSphere = new IcosahedronGeometry(4.2, 2);
      const wireMat = new MeshBasicMaterial({
        color: 0xffffff,
        wireframe: true,
        transparent: true,
        opacity: 0.08,
      });
      const wireMesh = new Mesh(geoSphere, wireMat);
      wireMesh.position.set(3.4, 0.2, -2.5);
      rootGroup.add(wireMesh);

      const ringGeo = new TorusGeometry(5.1, 0.018, 16, 100);
      const ringMat = new MeshBasicMaterial({
        color: 0xffb38a,
        transparent: true,
        opacity: 0.18,
      });
      const orbitalRing = new Mesh(ringGeo, ringMat);
      orbitalRing.position.set(3.4, 0.2, -2.5);
      orbitalRing.rotation.set(Math.PI * 0.32, Math.PI * 0.18, 0);
      rootGroup.add(orbitalRing);

      const nodePositions: Vector3[] = [
        new Vector3(-6.2, 2.4, -1.5),
        new Vector3(-3.8, -2.1, 0.5),
        new Vector3(-1.4, 2.8, -0.8),
        new Vector3(-0.5, -1.5, 1.2),
        new Vector3(1.8, 2.2, 0.4),
        new Vector3(2.9, -2.4, -0.4),
        new Vector3(5.6, 1.9, -0.6),
        new Vector3(6.4, -1.6, 0.8),
        new Vector3(3.6, 0.3, 1.8),
      ];

      const nodeGeo = new SphereGeometry(0.11, 16, 16);
      const nodeHaloGeo = new RingGeometry(0.16, 0.26, 24);
      const nodeMat = new MeshBasicMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0.85,
      });
      const haloMat = new MeshBasicMaterial({
        color: 0xffcfb3,
        side: DoubleSide,
        transparent: true,
        opacity: 0.35,
      });

      const nodeMeshes: Mesh[] = [];
      nodePositions.forEach((pos) => {
        const node = new Mesh(nodeGeo, nodeMat);
        node.position.copy(pos);
        rootGroup.add(node);

        const halo = new Mesh(nodeHaloGeo, haloMat.clone());
        halo.position.copy(pos);
        rootGroup.add(halo);
        nodeMeshes.push(halo);
      });

      const routePairs: [number, number][] = [
        [0, 2],
        [0, 1],
        [1, 3],
        [2, 4],
        [3, 4],
        [3, 5],
        [4, 8],
        [8, 6],
        [5, 7],
        [8, 7],
        [4, 6],
      ];

      interface CourierPulse {
        mesh: Mesh;
        curve: QuadraticBezierCurve3;
        progress: number;
        speed: number;
      }

      const pulses: CourierPulse[] = [];
      const pulseGeo = new SphereGeometry(0.075, 12, 12);
      const pulseMat = new MeshBasicMaterial({
        color: 0xfff3ed,
        transparent: true,
        opacity: 0.95,
      });

      const arcMat = new LineBasicMaterial({
        color: 0xffffff,
        transparent: true,
        opacity: 0.16,
      });

      routePairs.forEach(([startIdx, endIdx], idx) => {
        const start = nodePositions[startIdx];
        const end = nodePositions[endIdx];
        const mid = start.clone().lerp(end, 0.5);
        mid.y += 0.9 + (idx % 3) * 0.35;
        mid.z += 0.6;

        const curve = new QuadraticBezierCurve3(start, mid, end);
        const points = curve.getPoints(36);
        const arcGeo = new BufferGeometry().setFromPoints(points);
        const arcLine = new Line(arcGeo, arcMat);
        rootGroup.add(arcLine);

        const pulseMesh = new Mesh(pulseGeo, pulseMat);
        rootGroup.add(pulseMesh);
        pulses.push({
          mesh: pulseMesh,
          curve,
          progress: (idx * 0.19) % 1,
          speed: 0.0022 + (idx % 4) * 0.0006,
        });
      });

      const particleCount = 65;
      const positions = new Float32Array(particleCount * 3);
      for (let i = 0; i < particleCount; i++) {
        positions[i * 3] = (Math.random() - 0.5) * 20;
        positions[i * 3 + 1] = (Math.random() - 0.5) * 11;
        positions[i * 3 + 2] = (Math.random() - 0.5) * 6 - 1;
      }
      const particleGeo = new BufferGeometry();
      particleGeo.setAttribute('position', new BufferAttribute(positions, 3));
      const particleMat = new PointsMaterial({
        color: 0xffe4d6,
        size: 0.065,
        transparent: true,
        opacity: 0.45,
      });
      const particles = new Points(particleGeo, particleMat);
      rootGroup.add(particles);

      const updateSize = () => {
        const rect = wrapper.getBoundingClientRect();
        const width = Math.max(rect.width, 1);
        const height = Math.max(rect.height, 1);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height, false);
      };

      updateSize();
      canvas.classList.remove('opacity-0');

      let pointerX = 0;
      let pointerY = 0;
      let targetX = 0;
      let targetY = 0;

      const onPointerMove = (e: PointerEvent) => {
        const rect = wrapper.getBoundingClientRect();
        pointerX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        pointerY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
      };

      window.addEventListener('pointermove', onPointerMove, { passive: true });

      const resizeObserver = new ResizeObserver(() => {
        updateSize();
        if (prefersReducedMotion) {
          renderer.render(scene, camera);
        }
      });
      resizeObserver.observe(wrapper);

      if (prefersReducedMotion) {
        pulses.forEach((p) => {
          p.mesh.position.copy(p.curve.getPoint(p.progress));
        });
        renderer.render(scene, camera);
        return;
      }

      let isVisible = true;
      let rafId = 0;
      let elapsed = 0;

      const animate = () => {
        if (!isVisible) return;
        rafId = requestAnimationFrame(animate);
        elapsed += 0.012;

        targetX += (pointerX - targetX) * 0.04;
        targetY += (pointerY - targetY) * 0.04;

        rootGroup.rotation.y = targetX * 0.18 + Math.sin(elapsed * 0.35) * 0.04;
        rootGroup.rotation.x = -targetY * 0.12 + Math.cos(elapsed * 0.25) * 0.03;

        wireMesh.rotation.y += 0.0018;
        wireMesh.rotation.x += 0.0009;
        orbitalRing.rotation.z -= 0.0022;
        particles.rotation.y = elapsed * 0.03;

        nodeMeshes.forEach((halo, idx) => {
          const scale = 1 + Math.sin(elapsed * 2.2 + idx) * 0.22;
          halo.scale.set(scale, scale, 1);
        });

        pulses.forEach((p) => {
          p.progress = (p.progress + p.speed) % 1;
          p.mesh.position.copy(p.curve.getPoint(p.progress));
        });

        renderer.render(scene, camera);
      };

      const intersectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (!isVisible) {
                isVisible = true;
                rafId = requestAnimationFrame(animate);
              }
            } else {
              isVisible = false;
              cancelAnimationFrame(rafId);
            }
          });
        },
        { threshold: 0.05 }
      );

      intersectionObserver.observe(wrapper);
      rafId = requestAnimationFrame(animate);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThreeHeroes);
  } else {
    initThreeHeroes();
  }
</script>
