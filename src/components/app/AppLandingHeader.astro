---
import { ORDERS_WEB_URL } from '../../data/site';
---

<header class="sticky top-0 z-50 bg-brand-orange text-white border-b border-brand-darkOrange/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[72px] flex items-center justify-between">
    <a href="/" class="flex items-center shrink-0" aria-label="Agus App - Inicio">
      <img src="/assets/white-logo-agus.png" alt="Agus App" class="h-12 w-auto" />
    </a>
    <div class="flex items-center gap-4">
      <a
        href={ORDERS_WEB_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-web-orders-link
        data-web-orders-source="app_header"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white text-brand-orange font-semibold text-xs sm:text-sm hover:bg-brand-wash transition-colors shadow-sm"
      >
        <i class="ri-shopping-bag-3-line text-base"></i>
        <span>Pedir en la web</span>
      </a>
      <a
        href="/"
        class="text-sm font-medium text-white/90 hover:text-white transition-colors hidden sm:inline-block"
      >
        Ir al sitio principal
      </a>
    </div>
  </div>
</header>
